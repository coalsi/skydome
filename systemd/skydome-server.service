# The SkyDome server (D-020, D-021): the web page and its API, and ONVIF for
# NVRs, on port 80 via CAP_NET_BIND_SERVICE. Replaces skydome-onvif.service:
#   sudo systemctl disable --now skydome-onvif; sudo rm /etc/systemd/system/skydome-onvif.service
#   sudo cp systemd/skydome-server.service /etc/systemd/system/ && sudo systemctl enable --now skydome-server
[Unit]
Description=SkyDome server (web page, API, ONVIF)
After=network-online.target mediamtx.service
Wants=network-online.target

[Service]
User=skydome
WorkingDirectory=/home/skydome/skydome
ExecStart=/home/skydome/.local/bin/uv run --project pipeline tools/run_server.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
